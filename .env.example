# PostgreSQL. Local default matches the README. Use Neon or Supabase in production.
DATABASE_URL="postgresql://diba:diba@localhost:5432/diba_meals?schema=public"

# Public site origin, used for metadata, sitemap and shared links.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:4317"

# WhatsApp support, digits only, no plus. Example: 2348090002210
NEXT_PUBLIC_WHATSAPP_E164="2348090002210"

# mock skips Paystack and marks a demo payment. live calls Paystack.
PAYMENTS_MODE="mock"
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Auth.js / NextAuth. Required before staff login (phase 4).
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://127.0.0.1:4317"

# HMAC secret for meal-pass QR tokens. Server only.
PASS_TOKEN_SECRET="replace-with-a-long-random-string"

# Resend. Leave blank until confirmation emails are wired.
RESEND_API_KEY=""
EMAIL_FROM="Diba Meals <orders@dibameals.test>"

# Image storage. Use a different bucket or cloud name for production than for dev.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or Supabase Storage instead of Cloudinary:
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="diba-meals-dev"

# Google Maps. Restrict the browser key by HTTP referrer in Google Cloud.
# Places autocomplete is admin-only. The public map uses the browser key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Optional analytics. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
