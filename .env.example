# PostgreSQL. Local default matches the README. Use Neon or Supabase in production.
DATABASE_URL="postgresql://diba:diba@localhost:5432/diba_meals?schema=public"

# Public site origin, used for metadata, sitemap and shared links.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:4317"

# WhatsApp support, digits only, no plus. Example: 2348090002210
NEXT_PUBLIC_WHATSAPP_E164="2348090002210"

# mock skips Payaza and marks a demo payment. live opens Payaza Checkout.
# Mock stays the default unless this is exactly live, even when the keys below are set.
PAYMENTS_MODE="mock"
# Public key. The browser sends it as merchant_key. The server base64-encodes it for the status query.
# Not a secret, but do not commit a real key. Payaza's status endpoint documents this public key, not the secret.
NEXT_PUBLIC_PAYAZA_PUBLIC_KEY=""
# Test or Live. Must match the key. Anything other than Live is Test.
NEXT_PUBLIC_PAYAZA_MODE="Test"
# Secret. HMAC key for the x-payaza-signature webhook header. Server only. Never prefix with NEXT_PUBLIC_.
PAYAZA_SECRET_KEY=""

# Auth.js / NextAuth. Required before staff login (phase 4).
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://127.0.0.1:4317"

# HMAC secret for meal-pass QR tokens. Server only.
PASS_TOKEN_SECRET="replace-with-a-long-random-string"

# Resend. Leave blank to log confirmation and magic-link emails to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Diba Meals <orders@dibameals.test>"

# Optional bearer token for GET/POST /api/cron/release-holds.
CRON_SECRET=""

# Vercel Blob. In the Vercel project open Storage, create a Blob store, and connect it.
# That sets BLOB_READ_WRITE_TOKEN. Leave it blank locally: the admin still saves text and shows a setup message.
# Do not prefix this with NEXT_PUBLIC_. It is a server write token.
BLOB_READ_WRITE_TOKEN=""

# Older image options. Menu photos now use Vercel Blob. These can stay empty.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="diba-meals-dev"

# Google Maps. Restrict the browser key by HTTP referrer in Google Cloud.
# Places autocomplete is admin-only. The public map uses the browser key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Optional analytics. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
