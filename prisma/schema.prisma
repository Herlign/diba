// Schema for all five phases. Amounts are integer kobo. Times of day are HH:mm in Africa/Lagos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgrammeStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum OrderSlotStatus {
  SCHEDULED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  MISSED
  CANCELLED
}

enum StaffRole {
  SUPER_ADMIN
  CHURCH_ADMIN
  KITCHEN
  DISPATCH
}

enum PlanPricingMode {
  FIXED_PER_SLOT
  PERCENT_DISCOUNT
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Church {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  logoUrl      String?
  contactPhone String
  contactEmail String
  isActive     Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  programmes Programme[]
  staff      StaffUser[]
}

model Venue {
  id         String    @id @default(cuid())
  name       String
  address    String
  lat        Float?
  lng        Float?
  placeId    String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deliveryPoints DeliveryPoint[]
  programmes     Programme[]
}

model DeliveryPoint {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([venueId, position])
}

model Programme {
  id               String          @id @default(cuid())
  churchId         String
  church           Church          @relation(fields: [churchId], references: [id])
  venueId          String
  venue            Venue           @relation(fields: [venueId], references: [id])
  title            String
  slug             String          @unique
  code             String          @unique
  description      String
  coverImageUrl    String?
  startDate        DateTime        @db.Date
  endDate          DateTime        @db.Date
  status           ProgrammeStatus @default(DRAFT)
  orderCutoffHours Int             @default(24)
  maxOrdersPerSlot Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  mealPeriods MealPeriod[]
  slots       MealSlot[]
  menuItems   ProgrammeMenuItem[]
  mealPlans   MealPlan[]
  orders      Order[]
  promoCodes  PromoCode[]

  @@index([status, startDate])
  @@index([churchId])
}

/// A serving window for one programme. Morning and Evening are the defaults; Afternoon can be added.
model MealPeriod {
  id                  String    @id @default(cuid())
  programmeId         String
  programme           Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  name                String
  deliveryWindowStart String
  deliveryWindowEnd   String
  position            Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  slots    MealSlot[]
  offerings ProgrammeMenuItemPeriod[]
  plans    MealPlanPeriod[]

  @@unique([programmeId, name])
  @@index([programmeId, position])
}

/// One programme day crossed with one meal period. Generated when dates or periods change.
model MealSlot {
  id           String     @id @default(cuid())
  programmeId  String
  programme    Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  mealPeriodId String
  mealPeriod   MealPeriod @relation(fields: [mealPeriodId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  capacity     Int?
  isOpen       Boolean    @default(true)
  cutoffAt     DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orderSlots OrderSlot[]

  @@unique([programmeId, mealPeriodId, date])
  @@index([programmeId, date])
  @@index([cutoffAt])
}

model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  position   Int
  isActive   Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items MenuItem[]
}

model MenuItem {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  name        String
  slug        String    @unique
  description String
  imageUrl    String
  dietaryTags String[]
  position    Int
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants MenuItemVariant[]
}

model MenuItemVariant {
  id            String   @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name          String
  priceKobo     Int
  servesCount   Int      @default(1)
  prepMinutes   Int      @default(30)
  isAvailable   Boolean  @default(true)
  isUnlimited   Boolean  @default(true)
  quantity      Int?
  isInventoryLow Boolean @default(false)
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offerings    ProgrammeMenuItem[]
  orderItems   OrderItem[]
  planDefaults MealPlan[]          @relation("PlanDefaultVariant")

  @@unique([menuItemId, name])
  @@index([menuItemId, position])
}

/// A variant offered on one programme, with an optional price override.
model ProgrammeMenuItem {
  id                String          @id @default(cuid())
  programmeId       String
  programme         Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  variantId         String
  variant           MenuItemVariant @relation(fields: [variantId], references: [id])
  priceKoboOverride Int?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  periods ProgrammeMenuItemPeriod[]

  @@unique([programmeId, variantId])
  @@index([programmeId])
}

model ProgrammeMenuItemPeriod {
  id                  String            @id @default(cuid())
  programmeMenuItemId String
  programmeMenuItem   ProgrammeMenuItem @relation(fields: [programmeMenuItemId], references: [id], onDelete: Cascade)
  mealPeriodId        String
  mealPeriod          MealPeriod        @relation(fields: [mealPeriodId], references: [id], onDelete: Cascade)

  @@unique([programmeMenuItemId, mealPeriodId])
}

model MealPlan {
  id                    String          @id @default(cuid())
  programmeId           String
  programme             Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  name                  String
  description           String
  coversAllDays         Boolean         @default(true)
  pricingMode           PlanPricingMode
  fixedPricePerSlotKobo Int?
  discountPercent       Int?
  attendeeChoosesItems  Boolean         @default(true)
  defaultVariantId      String?
  defaultVariant        MenuItemVariant? @relation("PlanDefaultVariant", fields: [defaultVariantId], references: [id])
  isPopular             Boolean         @default(false)
  position              Int             @default(0)
  isActive              Boolean         @default(true)
  archivedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  periods MealPlanPeriod[]
  orders  Order[]

  @@index([programmeId, position])
}

model MealPlanPeriod {
  id           String     @id @default(cuid())
  mealPlanId   String
  mealPlan     MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPeriodId String
  mealPeriod   MealPeriod @relation(fields: [mealPeriodId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, mealPeriodId])
}

model Attendee {
  id         String   @id @default(cuid())
  fullName   String
  phone      String   @unique
  email      String
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([email])
}

model Order {
  id                String      @id @default(cuid())
  reference         String      @unique
  attendeeId        String
  attendee          Attendee    @relation(fields: [attendeeId], references: [id])
  programmeId       String
  programme         Programme   @relation(fields: [programmeId], references: [id])
  status            OrderStatus @default(PENDING_PAYMENT)
  subtotalKobo      Int
  discountKobo      Int         @default(0)
  deliveryFeeKobo   Int         @default(0)
  serviceFeeKobo    Int         @default(0)
  totalKobo         Int
  deliveryPointId   String
  deliveryPoint     DeliveryPoint @relation(fields: [deliveryPointId], references: [id])
  numberOfPeople    Int         @default(1)
  dietaryNotes      String      @default("")
  mealPlanId        String?
  mealPlan          MealPlan?   @relation(fields: [mealPlanId], references: [id])
  /// Merchant payment reference. The column name is historical; Payaza stores the checkout reference here.
  paystackReference String?     @unique
  needsReview       Boolean     @default(false)
  isGroupOrder      Boolean     @default(false)
  groupName         String?
  accessToken       String      @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  slots          OrderSlot[]
  payment        Payment?
  refundRequests RefundRequest[]

  @@index([programmeId, status])
  @@index([attendeeId])
}

model OrderSlot {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealSlotId    String
  mealSlot      MealSlot        @relation(fields: [mealSlotId], references: [id])
  status        OrderSlotStatus @default(SCHEDULED)
  passToken     String          @unique
  deliveredAt   DateTime?
  deliveredById String?
  deliveredBy   StaffUser?      @relation(fields: [deliveredById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items          OrderItem[]
  refundRequests RefundRequest[]

  @@unique([orderId, mealSlotId])
  @@index([mealSlotId, status])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderSlotId   String
  orderSlot     OrderSlot       @relation(fields: [orderSlotId], references: [id], onDelete: Cascade)
  variantId     String
  variant       MenuItemVariant @relation(fields: [variantId], references: [id])
  quantity             Int
  unitPriceKobo        Int
  nameSnapshot         String
  /// Portion label at purchase. Null on orders placed before portion snapshots.
  variantLabelSnapshot String?
  createdAt            DateTime @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderSlotId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// PAYAZA for card checkout, MOCK for the demo payment. Older rows may still say PAYSTACK.
  provider   String        @default("PAYAZA")
  reference  String        @unique
  amountKobo Int
  currency   String        @default("NGN")
  status     PaymentStatus @default(PENDING)
  rawPayload Json?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

/// A cancellation before cutoff. Admin marks the refund in a later phase; nothing is refunded automatically.
model RefundRequest {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderSlotId String
  orderSlot   OrderSlot @relation(fields: [orderSlotId], references: [id], onDelete: Cascade)
  status      String    @default("REQUESTED")
  note        String    @default("")
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([status])
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole
  churchId     String?
  church       Church?   @relation(fields: [churchId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deliveries OrderSlot[]
}

/// Public website copy. One row. Added columns default to the previous hard-coded words.
model SiteContent {
  id           String   @id @default("site")
  eyebrow      String
  headlineLead String
  headlineRest String
  hero         String
  footer       String

  searchLabel       String @default("Find your programme")
  searchPlaceholder String @default("Find your programme — church, name or code")
  searchButton      String @default("Search")
  heroImageUrl      String @default("/images/jollof.jpg")
  heroImageAlt      String @default("Party jollof rice with grilled chicken skewers and fried fish")
  slipTitle         String @default("Reboot Camp · Surulere")
  platesHeading     String @default("Freshly prepared")
  platesIntro       String @default("Choose a slot, choose a plate, and collect it at a designated point inside the venue. Extras can be added to any slot.")
  programmesHeading String @default("Upcoming programmes")
  programmesIntro   String @default("Published programmes only. Drafts stay in the office until the church is ready.")
  programmesLink    String @default("All programmes")
  statProgrammes    String @default("Programmes")
  statChurches      String @default("Churches")
  programmesEmptyTitle String @default("Nothing is published yet")
  programmesEmptyBody  String @default("When a church opens a programme, it will land here.")
  programmesErrorTitle String @default("The board didn't load")
  programmesErrorBody  String @default("Give it a second and refresh. A fresh checkout still needs the database seeded.")
  faqHeading        String @default("Before you order")
  navProgrammes     String @default("Programmes")
  navOrders         String @default("My orders")
  navCta            String @default("Open lists")
  logoAlt           String @default("Diba Meals")
  logoUrl           String?
  footerNote        String @default("Orders close 24 hours before each slot.")
  footerStaff       String @default("Staff")
  footerWhatsapp    String @default("WhatsApp support")
  whatsappE164      String @default("")
  photoCredit       String @default("Food photos, free to use, from Pexels: Keesha's Kitchen · Harrun Muhammad · Tim Yisa · PICHA · mk_photoz · Teguh S · kandhi bharata.")
  boardEyebrow      String @default("The board")
  boardTitle        String @default("Find your programme")
  boardIntro        String @default("Search by church, programme name, or the code on the poster. Ordering closes 24 hours before each slot.")
  boardPlaceholder  String @default("Church, programme name, or code")
  boardSearch       String @default("Search")
  boardClear        String @default("Clear")
  boardEmptyTitle   String @default("No programme matches that")
  boardEmptyBody    String @default("Try the code on the church poster, or clear the search.")
  boardMetaDescription String @default("Find a church programme by name or code and see where Diba Meals is delivering.")
  boardShareDescription String @default("Camps, congresses and convocations taking meal orders.")
  orderButton       String @default("Order meals")
  menuSoon          String @default("Menu soon")
  missingEyebrow    String @default("Missing page")
  missingTitle      String @default("That page is not on the menu")
  missingBody       String @default("The link may be old. The programme list is the place to start.")
  missingButton     String @default("Browse programmes")
  ordersEyebrow     String @default("My orders")
  ordersTitle       String @default("Find the meals you booked")
  ordersBody        String @default("Use the email from checkout. We'll send a link that opens every order on that address. It lasts 2 hours.")
  ordersEmailLabel  String @default("Email")
  ordersButton      String @default("Email me a link")
  ordersSending     String @default("Sending…")
  siteName          String @default("Diba Meals")
  socialExtra       String @default("Morning, afternoon and evening, delivered at the programme venue.")
  ogImageAlt        String @default("Diba Meals")
  ogImageUrl        String?
  faviconUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs          FaqEntry[]
  steps         HomeStep[]
  showcases     HomeShowcase[]
  slipLines     HomeSlipLine[]
  marqueeItems  HomeMarqueeItem[]
  trustPoints   HomeTrustPoint[]
}

/// Numbered step on the homepage. The number follows the position.
model HomeStep {
  id        String      @id @default(cuid())
  siteId    String      @default("site")
  site      SiteContent @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title     String
  body      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([siteId, position])
}

/// A plate card in the Freshly prepared section.
model HomeShowcase {
  id         String      @id @default(cuid())
  siteId     String      @default("site")
  site       SiteContent @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name       String
  note       String
  imageUrl   String
  imageAlt   String
  imageFocus String      @default("")
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([siteId, position])
}

/// One line on the gold sample-order card over the homepage photo.
model HomeSlipLine {
  id        String      @id @default(cuid())
  siteId    String      @default("site")
  site      SiteContent @relation(fields: [siteId], references: [id], onDelete: Cascade)
  whenLabel String
  plate     String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([siteId, position])
}

/// A name in the scrolling gold band.
model HomeMarqueeItem {
  id        String      @id @default(cuid())
  siteId    String      @default("site")
  site      SiteContent @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([siteId, position])
}

/// A short line under the homepage search box.
model HomeTrustPoint {
  id        String      @id @default(cuid())
  siteId    String      @default("site")
  site      SiteContent @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([siteId, position])
}

model FaqEntry {
  id        String      @id @default(cuid())
  siteId    String      @default("site")
  site      SiteContent @relation(fields: [siteId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([siteId, position])
}

model PromoCode {
  id           String            @id @default(cuid())
  code         String            @unique
  discountType PromoDiscountType
  percentOff   Int?
  amountKobo   Int?
  programmeId  String?
  programme    Programme?        @relation(fields: [programmeId], references: [id])
  usageLimit   Int?
  usedCount    Int               @default(0)
  expiresAt    DateTime?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}
